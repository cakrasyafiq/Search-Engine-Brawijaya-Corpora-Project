# PostgreSQL Database Connection (Pure Python pg8000 driver recommended on Windows)
# Format: postgresql+pg8000://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/lexicon_db

# BM25 Hyperparameters
BM25_K1=1.5
BM25_B=0.75

# Inverted Index Cache Path
INDEX_CACHE_PATH=bm25_index.pkl

# Application Settings
APP_NAME="Lexicon BM25 Search Engine"
DEBUG=True
API_V1_PREFIX=""
